DATABASE_URL=postgresql://user:password@localhost:5432/senses
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/senses_test
APP_NAME=SENSES Project Management API
LOG_LEVEL=INFO
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GCS_PROJECT_ID=your-gcp-project-id
DOCUMENT_COLLABORATION_WS_URL=ws://127.0.0.1:1234/documents
DOCUMENT_COLLABORATION_HEALTH_URL=http://127.0.0.1:1235/documents/health
COLLABORATION_DATABASE_URL=
SHARED_COORDINATION_URL=redis://127.0.0.1:6379/0
UNIVER_COLLABORATION_ENDPOINT=https://your-univer-collaboration-server.example.com
UNIVER_COLLABORATION_HEALTH_URL=https://your-univer-collaboration-server.example.com/health
GCS_BUCKET_NAME=your-private-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
MAX_UPLOAD_BYTES=10485760
