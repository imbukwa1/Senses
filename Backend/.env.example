DATABASE_URL=postgresql://user:password@localhost:5432/senses
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/senses_test
APP_NAME=SENSES Project Management API
LOG_LEVEL=INFO
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-private-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
MAX_UPLOAD_BYTES=10485760
